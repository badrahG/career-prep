# ── Database ──────────────────────────────────────────────────────────────────
# Local dev default. Docker Compose overrides this automatically.
DATABASE_URL=postgresql://odoo:odoo123@localhost:5432/career_platform

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# ── API ───────────────────────────────────────────────────────────────────────
# Used to build absolute URLs for uploaded files
API_BASE_URL=http://localhost:8001

# ── Claude AI (CV Analysis) ───────────────────────────────────────────────────
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
# Leave SMTP_USER empty to disable email sending (logs to console instead)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=CareerPrep
FRONTEND_URL=http://localhost:5173
