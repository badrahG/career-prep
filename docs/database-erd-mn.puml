@startuml
hide circle
skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam defaultFontName "Arial"
skinparam defaultFontSize 13
skinparam roundcorner 8

skinparam entity {
  BackgroundColor #FFF2CC
  BorderColor #7F6000
  FontColor #111111
}

skinparam note {
  BackgroundColor #F3F6FA
  BorderColor #6C7A89
}

title CareerPrep системийн өгөгдлийн сангийн ерөнхий схем

entity "Хэрэглэгч\n(users)" as users {
  * ХэрэглэгчID : integer <<PK>>
  --
  * нэр : varchar(100)
  * овог : varchar(100)
  * email : varchar(255) <<unique>>
  * нууц үг : varchar(255)
  утас : varchar(20)
  * эрх : varchar(10)
  * идэвхтэй эсэх : bit
  * баталгаажсан эсэх : bit
  баталгаажсан огноо : timestamp
  * амжилтгүй нэвтрэх тоо : integer
  түгжээ дуусах хугацаа : timestamp
  * үүсгэсэн огноо : timestamp
  шинэчилсэн огноо : timestamp
}

entity "CV\n(cvs)" as cvs {
  * CVID : integer <<PK>>
  --
  * ХэрэглэгчID : integer <<FK>>
  * нэр : varchar(200)
  загварын төрөл : varchar(50)
  хувийн мэдээлэл : varchar(2000)
  * үүсгэсэн огноо : timestamp
  шинэчилсэн огноо : timestamp
}

entity "Боловсрол\n(educations)" as educations {
  * БоловсролID : integer <<PK>>
  --
  * CVID : integer <<FK>>
  * сургууль : varchar(200)
  мэргэжил : varchar(200)
  эхэлсэн он : integer
  төгссөн он : integer
  gpa : float
}

entity "Ажлын туршлага\n(work_experiences)" as work_experiences {
  * АжлынТуршлагаID : integer <<PK>>
  --
  * CVID : integer <<FK>>
  * байгууллага : varchar(200)
  албан тушаал : varchar(200)
  эхэлсэн огноо : varchar(20)
  дууссан огноо : varchar(20)
  тайлбар : varchar(4000)
}

entity "Ур чадвар\n(skills)" as skills {
  * УрЧадварID : integer <<PK>>
  --
  * CVID : integer <<FK>>
  * ур чадварын нэр : varchar(100)
  ур чадварын төрөл : varchar(50)
  түвшин : varchar(50)
}

entity "CV загвар\n(cv_templates)" as cv_templates {
  * CVЗагварID : integer <<PK>>
  --
  * түлхүүр : varchar(50) <<unique>>
  * нэр : varchar(100)
  тайлбар : varchar(1000)
  preview холбоос : varchar(500)
  * идэвхтэй эсэх : bit
  * эрэмбэ : integer
  * үүсгэсэн огноо : timestamp
}

entity "Ярилцлагын кейс\n(interview_cases)" as interview_cases {
  * ЯрилцлагынКейсID : integer <<PK>>
  --
  * гарчиг : varchar(255)
  * case текст : varchar(4000)
  хүндрэл : varchar(20)
  * үүсгэсэн огноо : timestamp
}

entity "Ярилцлагын асуулт\n(interview_questions)" as interview_questions {
  * ЯрилцлагынАсуултID : integer <<PK>>
  --
  ЯрилцлагынКейсID : integer <<FK>>
  * асуулт : varchar(4000)
  * ангилал : varchar(20)
  жишээ хариулт : varchar(4000)
  зөвлөгөө : varchar(2000)
  хүндрэл : varchar(20)
  шошгонууд : varchar(255)
  * quiz эсэх : bit
  A сонголт : varchar(1000)
  B сонголт : varchar(1000)
  C сонголт : varchar(1000)
  D сонголт : varchar(1000)
  зөв сонголт : varchar(1)
  тайлбар : varchar(2000)
  * үүсгэсэн огноо : timestamp
  шинэчилсэн огноо : timestamp
}

entity "Quiz үр дүн\n(user_quiz_results)" as user_quiz_results {
  * QuizҮрДүнID : integer <<PK>>
  --
  * ХэрэглэгчID : integer <<FK>>
  * нийт асуулт : integer
  * зөв хариулт : integer
  * хувь : float
  * үүсгэсэн огноо : timestamp
}

entity "Flashcard явц\n(user_flashcard_progress)" as user_flashcard_progress {
  * FlashcardЯвцID : integer <<PK>>
  --
  * ХэрэглэгчID : integer <<FK>>
  * ЯрилцлагынАсуултID : integer <<FK>>
  * үзсэн огноо : timestamp
}

entity "Тэтгэлэг\n(scholarships)" as scholarships {
  * ТэтгэлэгID : integer <<PK>>
  --
  * нэр : varchar(300)
  байгууллага : varchar(300)
  зорилтот бүлэг : varchar(100)
  шаардлага : varchar(4000)
  эцсийн хугацаа : date
  веб холбоос : varchar(500)
  тайлбар : varchar(4000)
  зургийн холбоос : varchar(500)
  gpa : varchar(50)
  үргэлжлэх хугацаа : varchar(200)
}

entity "Тэтгэлгийн шалгах жагсаалт\n(user_scholarship_checklists)" as user_scholarship_checklists {
  * ТэтгэлгийнЖагсаалтID : integer <<PK>>
  --
  * ХэрэглэгчID : integer <<FK>>
  * ТэтгэлэгID : integer <<FK>>
  * жагсаалтын зүйлс : varchar(4000)
  * шинэчилсэн огноо : timestamp
  --
  unique(ХэрэглэгчID, ТэтгэлэгID)
}

entity "Хадгалсан тэтгэлэг\n(scholarship_bookmarks)" as scholarship_bookmarks {
  * ХадгалсанТэтгэлэгID : integer <<PK>>
  --
  * ХэрэглэгчID : integer <<FK>>
  * ТэтгэлэгID : integer <<FK>>
  * үүсгэсэн огноо : timestamp
  --
  unique(ХэрэглэгчID, ТэтгэлэгID)
}

entity "Зөвлөгөө\n(advices)" as advices {
  * ЗөвлөгөөID : integer <<PK>>
  --
  * ангилал : varchar(20)
  * гарчиг : varchar(255)
  хураангуй : varchar(2000)
  * агуулга : varchar(4000)
  youtube холбоос : varchar(500)
  гадаад холбоосууд : varchar(4000)
  * эрэмбэ : integer
  * нийтлэгдсэн эсэх : bit
  * үүсгэсэн огноо : timestamp
  шинэчилсэн огноо : timestamp
}

entity "Имэйл токен\n(email_tokens)" as email_tokens {
  * ИмэйлТокенID : integer <<PK>>
  --
  * ХэрэглэгчID : integer <<FK>>
  * token : varchar(255) <<unique>>
  * token төрөл : varchar(30)
  * дуусах хугацаа : timestamp
  ашигласан огноо : timestamp
  * үүсгэсэн огноо : timestamp
}

entity "Сэргээх токен\n(refresh_tokens)" as refresh_tokens {
  * СэргээхТокенID : integer <<PK>>
  --
  * ХэрэглэгчID : integer <<FK>>
  * token hash : varchar(64) <<unique>>
  * дуусах хугацаа : timestamp
  хүчингүй болгосон огноо : timestamp
  * үүсгэсэн огноо : timestamp
}

entity "Аудит лог\n(audit_logs)" as audit_logs {
  * АудитЛогID : integer <<PK>>
  --
  ХэрэглэгчID : integer <<FK>>
  * үйлдэл : varchar(100)
  IP хаяг : varchar(45)
  дэлгэрэнгүй : varchar(2000)
  * үүсгэсэн огноо : timestamp
}

' ── FK холбоосууд ──────────────────────────────────────────
users ||--o{ cvs : "үүсгэнэ"
cvs ||--o{ educations : "агуулна"
cvs ||--o{ work_experiences : "агуулна"
cvs ||--o{ skills : "агуулна"

interview_cases ||--o{ interview_questions : "кейсийн асуулт"
users ||--o{ user_quiz_results : "quiz өгнө"
users ||--o{ user_flashcard_progress : "үзсэн"
interview_questions ||--o{ user_flashcard_progress : "асуултын явц"

users ||--o{ user_scholarship_checklists : "бөглөнө"
scholarships ||--o{ user_scholarship_checklists : "шалгах жагсаалт"
users ||--o{ scholarship_bookmarks : "хадгална"
scholarships ||--o{ scholarship_bookmarks : "хадгалсан"

users ||--o{ email_tokens : "баталгаажуулалт / сэргээх"
users ||--o{ refresh_tokens : "нэвтрэлт"
users |o--o{ audit_logs : "үйлдэл"

' ── Логик холбоос (FK биш) ────────────────────────────────
cv_templates ..> cvs : "загварын төрөл\n(түлхүүр → template_type)"

note right of advices
  Өгөгдлийн санд FK байхгүй.
  Ангилалаараа CV, ярилцлага,
  тэтгэлгийн сэдэвт хамаарна.
end note

@enduml
