flowchart LR
    user["User<br/>Student / Job Seeker / Admin"]

    subgraph frontend["FRONTEND ( REACT )"]
        direction LR
        browser["Web Client"]
        react["ReactJS"]
        tailwind["Tailwind CSS"]
        jwt["JWT<br/>User Authentication"]

        browser --> react
        react --> tailwind
        react --> jwt
    end

    subgraph backend["BACKEND ( FASTAPI + PYTHON )"]
        direction LR
        middleware["Auth Middleware<br/>CORS / CSRF / Rate Limit"]
        api["REST API Layers<br/>FastAPI Routers"]

        subgraph controllers["Routers / Controllers"]
            direction TB
            authController["Auth Router"]
            cvController["CV Router"]
            interviewController["Interview Router"]
            scholarshipController["Scholarship Router"]
            adviceController["Advice Router"]
            adminController["Admin Router"]
        end

        subgraph services["Services"]
            direction TB
            authService["Auth Service"]
            emailService["Email Service"]
            cvService["CV Logic"]
            interviewService["Interview Logic"]
            scholarshipService["Scholarship Logic"]
            adviceService["Advice Logic"]
            adminService["Admin Logic"]
        end
    end

    subgraph database["DATABASES / STORAGE"]
        direction TB
        postgres["PostgreSQL"]
        uploads["Uploads Storage"]
        smtp["SMTP / Gmail"]
    end

    user --> browser
    jwt --> middleware
    middleware --> api

    api --> authController
    api --> cvController
    api --> interviewController
    api --> scholarshipController
    api --> adviceController
    api --> adminController

    authController --> authService
    authController --> emailService
    cvController --> cvService
    interviewController --> interviewService
    scholarshipController --> scholarshipService
    adviceController --> adviceService
    adminController --> adminService
    adminController --> emailService
    scholarshipService --> emailService

    authService --> postgres
    cvService --> postgres
    interviewService --> postgres
    scholarshipService --> postgres
    adviceService --> postgres
    adminService --> postgres
    cvService --> uploads
    emailService --> smtp

    classDef userStyle fill:#ffffff,stroke:#111827,stroke-width:1px,color:#111827;
    classDef frontNode fill:#dbeafe,stroke:#7aa2f7,stroke-width:1px,color:#111827;
    classDef backNode fill:#f3f4f6,stroke:#6b7280,stroke-width:1px,color:#111827;
    classDef apiNode fill:#eadcf8,stroke:#b794d4,stroke-width:1px,color:#111827;
    classDef controllerNode fill:#dcfce7,stroke:#86efac,stroke-width:1px,color:#111827;
    classDef serviceNode fill:#dbeafe,stroke:#93c5fd,stroke-width:1px,color:#111827;
    classDef dbNode fill:#fee2e2,stroke:#fca5a5,stroke-width:1px,color:#111827;

    class user userStyle;
    class browser,react,tailwind,jwt frontNode;
    class middleware backNode;
    class api apiNode;
    class authController,cvController,interviewController,scholarshipController,adviceController,adminController controllerNode;
    class authService,emailService,cvService,interviewService,scholarshipService,adviceService,adminService serviceNode;
    class postgres,uploads,smtp dbNode;

    style frontend fill:#eef4ff,stroke:#8ab4f8,stroke-width:1px,stroke-dasharray: 5 5;
    style backend fill:#fafafa,stroke:#9ca3af,stroke-width:1px,stroke-dasharray: 5 5;
    style controllers fill:#ffffff,stroke:#9ca3af,stroke-width:1px,stroke-dasharray: 5 5;
    style services fill:#e8f0fb,stroke:#93a9c7,stroke-width:1px,stroke-dasharray: 5 5;
    style database fill:#fff7f7,stroke:#f2a3a3,stroke-width:1px,stroke-dasharray: 5 5;
